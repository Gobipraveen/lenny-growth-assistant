# ==============================================================================
# Lenny Growth Assistant - Environment Configuration Example
# ==============================================================================
# Copy this file to .env for local overrides. Never commit actual API keys or secrets.

# Backend Configuration
APP_NAME="The Lenny Growth Assistant Backend"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (comma-separated origins or list format)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database (Provisional connection URL placeholder)
DATABASE_URL="postgresql://lenny_app:CHANGE_ME@localhost:5432/lenny_assistant"

# LLM Providers (ollama | anthropic | openai)
LLM_PROVIDER="ollama"

# Ollama Local Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:1.5b"

# Cloud LLM API Keys (Placeholders only - do not commit real keys)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"
