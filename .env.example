# ==============================================================================
# Lenny Growth Assistant - Environment Configuration Example
# ==============================================================================
# Copy this file to .env for local overrides. Never commit actual API keys or secrets.

# Backend Configuration
APP_NAME="The Lenny Growth Assistant Backend"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (comma-separated origins or list format)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database (Provisional connection URL placeholder)
DATABASE_URL="postgresql://lenny_app:CHANGE_ME@localhost:5432/lenny_assistant"

# LLM Providers (ollama | anthropic)
LLM_PROVIDER="ollama"

# Ollama Local Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:1.5b"

# Cloud LLM Configuration (Placeholders only - do not commit real keys)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
OPENAI_API_KEY=""

# Agent Service Bridge (Node.js Pi Agent Service)
AGENT_SERVICE_HOST="127.0.0.1"
AGENT_SERVICE_PORT=8001
AGENT_SERVICE_URL="http://127.0.0.1:8001"
# Required shared authentication secret for internal FastAPI <-> Node.js agent communication.
# Generate a private random token (e.g. `openssl rand -hex 32`) and paste it here in .env.
# Both FastAPI and the Node.js Agent Service read this secret. Fails closed if empty.
AGENT_INTERNAL_SECRET=""
AGENT_SERVICE_TIMEOUT=60
FASTAPI_INTERNAL_URL="http://127.0.0.1:8000"
